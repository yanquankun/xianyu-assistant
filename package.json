{
  "name": "xianyu-assistant",
  "version": "0.1.3",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "将淘宝、天猫和京东商品整理为闲鱼发布草稿的 Chrome 侧边栏扩展",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "prepare": "wxt prepare",
    "dev": "wxt --config wxt.dev.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && wxt build --mode e2e && playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "wxt prepare && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build:unpacked": "wxt build && node scripts/collect-build-artifacts.mjs --unpacked-only",
    "build": "wxt zip && node scripts/collect-build-artifacts.mjs",
    "zip": "pnpm build"
  },
  "dependencies": {
    "opentype.js": "2.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "20.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
